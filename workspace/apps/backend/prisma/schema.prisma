// Crypto Strategy Lab — Prisma Schema
// Sourced from kb/contracts/*.yaml
// Run: npx prisma generate && npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Market Data — kb/contracts/market-data.yaml
// ──────────────────────────────────────────────

model Candle {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String
  openTime  DateTime
  closeTime DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  isClosed  Boolean

  @@unique([symbol, timeframe, openTime])
  @@index([symbol, timeframe, openTime])
}

model TradingPair {
  id         Int     @id @default(autoincrement())
  symbol     String  @unique
  baseAsset  String
  quoteAsset String
  isActive   Boolean @default(true)
}

// ──────────────────────────────────────────────
// Strategy Engine — kb/contracts/strategy.yaml
// ──────────────────────────────────────────────

model StrategyVersion {
  id              String   @id @default(uuid())
  userId          String?  // null = system-discovered (shared), non-null = user-created (private). See ADR-0016
  strategyType    String
  name            String
  version         Int
  parameters      Json
  parentVersionId String?
  isComposite     Boolean  @default(false)
  childVersionIds String[]
  combinerType    String?
  combinerWeights Json?
  createdAt       DateTime @default(now())

  backtestResults BacktestResult[]

  @@index([strategyType])
}

model BacktestResult {
  id                String   @id @default(uuid())
  jobId             String   @unique
  userId            String?  // null = system backtest (from loop), non-null = user-initiated. See ADR-0016
  strategyVersionId String
  pair              String
  timeframe         String
  startDate         DateTime
  endDate           DateTime
  totalReturn       Float
  winRate           Float
  maxDrawdown       Float
  sharpeRatio       Float
  profitFactor      Float
  totalTrades       Int
  trades            Json
  executedAt        DateTime @default(now())
  executionTimeMs   Int

  strategyVersion   StrategyVersion @relation(fields: [strategyVersionId], references: [id])

  @@index([strategyVersionId])
  @@index([pair, timeframe])
}

// ──────────────────────────────────────────────
// News & Sentiment — kb/contracts/news.yaml
// ──────────────────────────────────────────────

model NewsArticle {
  id             String   @id @default(uuid())
  source         String
  title          String
  content        String
  url            String   @unique
  publishedAt    DateTime
  crawledAt      DateTime
  relatedCoins   String[]
  sentimentScore Float?
  sentimentLabel String?
  createdAt      DateTime @default(now())

  sentimentScores SentimentScore[]

  @@index([publishedAt])
  @@index([source])
  @@index([relatedCoins])
}

model SentimentScore {
  id        String   @id @default(uuid())
  articleId String
  score     Float
  label     String
  model     String
  scoredAt  DateTime @default(now())

  article NewsArticle @relation(fields: [articleId], references: [id])

  @@index([articleId])
}

model CrawlerRule {
  id                 String   @id @default(uuid())
  domain             String   @unique
  targetUrl          String
  containerSelector  String
  titleSelector      String
  contentSelector    String
  linkSelector       String
  dateSelector       String
  isActive           Boolean  @default(true)
  lastDiscoveredAt   DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("crawler_rules")
}

// ──────────────────────────────────────────────
// Event Infrastructure — kb/contracts/events.yaml
// + kb/modules/event-infrastructure.md Section 6
// Entity shapes defined by Phương, Prisma models written by Hoàng
// ──────────────────────────────────────────────

model LeaderboardEntry {
  id                  String   @id @default(uuid())
  userId              String?  // null = system entry (shared), non-null = user entry (private). See ADR-0016
  rank                Int
  strategyVersionId   String   // ID-only reference to StrategyVersion (no FK join, per MODULES.md Rule 2)
  strategyName        String
  strategyType        String
  isComposite         Boolean
  backtestResultId    String   @unique // ID-only reference to BacktestResult; UNIQUE for idempotent upsert
  score               Float
  totalReturn         Float
  winRate             Float
  maxDrawdown         Float
  sharpeRatio         Float
  totalTrades         Int
  executedAt          DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([rank])
  @@index([strategyVersionId])
}

model SearchLoopRun {
  id                          String    @id @default(uuid())
  status                      String    // RUNNING | PAUSED | COMPLETED | STOPPED_BY_USER | FAILED
  generatorType               String    // RANDOM | DOMAIN_GUIDED
  iteration                   Int       @default(0)
  testedCandidates            Int       @default(0)
  maxCandidates               Int?
  maxDurationMs               Int?
  stopOnNoImprovementIterations Int     @default(50)
  currentCandidateStrategyVersionId String?
  bestStrategyVersionId       String?
  bestScore                   Float?
  stopReason                  String?
  startedAt                   DateTime  @default(now())
  pausedAt                    DateTime?
  stoppedAt                   DateTime?

  candidates                  SearchLoopCandidate[]

  @@index([status])
}

model SearchLoopCandidate {
  id                  String   @id @default(uuid())
  loopRunId           String
  jobId               String   @unique
  strategyVersionId   String   // ID-only reference to StrategyVersion (no FK join)
  backtestResultId    String?  // ID-only reference to BacktestResult; nullable until backtest completes
  iteration           Int
  score               Float?
  status              String   // GENERATING | BACKTESTING | EVALUATED | FAILED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  loopRun             SearchLoopRun @relation(fields: [loopRunId], references: [id])

  @@index([loopRunId])
}

// Singleton desired-state and lease record for the 24/7 system search loop.
// Individual SearchLoopRun rows remain bounded; the supervisor creates the
// next run while this control is enabled.
model SearchLoopControl {
  id                              String    @id
  enabled                         Boolean   @default(false)
  generatorType                   String    @default("RANDOM")
  pair                            String    @default("BTCUSDT")
  timeframe                       String    @default("1h")
  backtestWindowDays              Int       @default(180)
  initialCapital                  Float     @default(10000)
  positionSizePercent             Float     @default(100)
  commission                      Float?
  slippage                        Float?
  maxCandidatesPerRun             Int?      @default(100)
  maxDurationMsPerRun             Int?
  stopOnNoImprovementIterations   Int       @default(50)
  cooldownMs                      Int       @default(30000)
  failureCount                    Int       @default(0)
  nextRunAt                       DateTime?
  lastStartedRunId                String?
  lastError                       String?
  leaseOwner                      String?
  leaseUntil                      DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@index([leaseUntil])
}

model DeadLetterJob {
  id              String    @id @default(uuid())
  jobId           String    @unique
  jobType         String
  payload         Json
  attempts        Int
  lastError       String
  deadLetteredAt  DateTime  @default(now())
  resolvedAt      DateTime?
}
