# Crypto Strategy Lab — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Database — Supabase Postgres (hosted; local docker Postgres no longer used).
# Supabase Dashboard → Connect → choose "Session mode" (direct connection, port 5432).
# IMPORTANT: Prisma migrations need the direct connection — do NOT use the
# transaction pooler (port 6543) here. Never commit the real password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public

# Backend (NestJS)
BACKEND_PORT=3001

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Python Sentiment Service & Ingestion (ADR-0010, ADR-0014)
SENTIMENT_SERVICE_URL=http://localhost:8000
SENTIMENT_SERVICE_TIMEOUT_MS=500
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss,https://cointelegraph.com/rss,https://decrypt.co/feed
NEWS_CRAWLER_TARGETS=https://cryptoslate.com/news/,https://bitcoinmagazine.com/articles

# Google Gemini LLM API (Crawler Selector Discovery & Self-Healing - ADR-0014)
# Get free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DISCOVERY_TIMEOUT_MS=10000

# Redis + BullMQ backtest queue (required by Event Infrastructure)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
BACKTEST_QUEUE_NAME=backtest
BACKTEST_WORKER_CONCURRENCY=3
BACKTEST_MAX_ATTEMPTS=3
BACKTEST_JOB_RETENTION_AGE_SECONDS=86400
BACKTEST_JOB_RETENTION_COUNT=1000

# Search Loop bootstrap default. Used only when SearchLoopControl does not yet exist.
# Production may set true for automatic 24/7 operation; local/CI can keep false.
SEARCH_LOOP_DEFAULT_ENABLED=false

# Comma-separated Supabase user UUIDs allowed to mutate the global Search Loop.
# Empty means deny all mutations; read-only status endpoints remain available.
SEARCH_LOOP_OPERATOR_USER_IDS=
