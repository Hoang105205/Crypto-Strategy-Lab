# Crypto Strategy Lab — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgresql://csl:csl_dev@localhost:5432/crypto_strategy_lab?schema=public

# Backend (NestJS)
BACKEND_PORT=3001

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Python Sentiment Service
SENTIMENT_SERVICE_URL=http://localhost:8000

# Redis (for BullMQ-ready job queue, future)
REDIS_URL=redis://localhost:6379
